# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Token API (/api/*) - each at least 32 random characters.
# Not needed by the React front end, which uses /api/app/* with the session cookie.
JWT_SECRET=
REFRESH_TOKEN_KEY=
